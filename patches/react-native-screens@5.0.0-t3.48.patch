+  if (@available(iOS 18.0, *)) {
+    [tabBarController setTabBarHidden:controller.hidesBottomBarWhenPushed animated:animated];
+  } else {
+    tabBarController.tabBar.hidden = controller.hidesBottomBarWhenPushed;
+  }
+}
+
+- (void)viewWillAppear:(BOOL)animated
+{
+  [self applyTabBarVisibilityForController:self.topViewController animated:NO];
