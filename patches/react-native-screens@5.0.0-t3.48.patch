+                        RNSStackNavigationController *strongSelf = weakSelf;
+                        if (context.isCancelled && strongSelf != nil) {
+                          [strongSelf applyTabBarVisibilityForController:strongSelf.topViewController animated:NO];
+                        }
+                      }];
+}
