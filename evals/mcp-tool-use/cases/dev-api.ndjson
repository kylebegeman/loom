{"id":"dev-api-import-only","kind":"guard","prompt":"Import the native Hoppscotch JSON files in /work/acme/api-pack as a separate Loom API workspace named Acme. Preserve the scripts and environments. Do not send any API requests, open a browser, or edit the original files.","setup":{"role":"top","mocks":{"loom_dev_api_workspace":{"workspaces":[],"workspace":{"workspace":{"id":"api-fixture","name":"Acme","requestCount":1,"environmentCount":1},"revision":"workspace-r1","requests":[{"id":"requests.json/c0/r0","name":"Health","folders":["Acme"],"method":"GET"}],"environments":[{"id":"local.json/e0","name":"Local"}],"dotenvFiles":[".env.local"],"selected":null}}}},"expect":{"calls":[{"tool":"loom_dev_api_workspace","args":{"action":"import","name":"Acme","directory":"/work/acme/api-pack"}}],"notCalls":["loom_dev_api_send","loom_dev_request","loom_dev_api_environment","loom_dev_start"],"callsMustNot":[{"tool":"loom_dev_api_workspace","args":{"action":"remove"}}]},"maxSteps":9,"area":"browser-dev-tools","pattern":"native API workspaces preserve scripts and explicit environment contexts","experience":"Kyle uses several Hoppscotch workspaces and requires imported JSON and actual project dotenv files to remain explicitly selected.","source":{"feature":"L11 API workspaces"}}
