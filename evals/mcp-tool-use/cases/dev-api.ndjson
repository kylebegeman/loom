ontexts","experience":"Kyle uses several Hoppscotch workspaces and requires imported JSON and actual project dotenv files to remain explicitly selected.","source":{"feature":"L11 API workspaces"}}
{"id":"dev-api-environment-patch","kind":"guard","prompt":"In API workspace api-fixture, change only API_ORIGIN in imported JSON environment local.json/e0 to http://localhost:5000. Read its revision and patch that one non-secret variable, preserving all other variables. Do not send any API requests or modify dotenv files.","setup":{"role":"top","mocks":{"loom_dev_api_environment":{"revision":"environment-r2","variables":[{"key":"API_ORIGIN","secret":false,"isSet":true}]},"loom_dev_api_workspace":{"workspaces":[],"workspace":{"workspace":{"id":"api-fixture","name":"Acme","requestCount":1,"environmentCount":1},"revision":"workspace-r1","requests":[{"id":"requests.json/c0/r0","name":"Health","folders":["Acme"],"method":"GET"}],"environments":[{"id":"local.json/e0","name":"Local"}],"dotenvFiles":[".env.local"],"selected":null}}}},"expect":{"calls":[{"tool":"loom_dev_api_environment","args":{"action":"read","source.kind":"json","source.id":"local.json/e0"}},{"tool":"loom_dev_api_environment","args":{"action":"save","expectedRevision":"environment-r2","source.kind":"json","source.id":"local.json/e0","variables":[{"key":"API_ORIGIN","value":"http://localhost:5000","secret":false}]}}],"notCalls":["loom_dev_api_send","loom_dev_request"],"maxCalls":{"loom_dev_api_environment":2}},"maxSteps":8,"area":"browser-dev-tools","pattern":"native API workspaces preserve scripts and explicit environment contexts","experience":"Kyle uses several Hoppscotch workspaces and requires imported JSON and actual project dotenv files to remain explicitly selected.","source":{"feature":"L11 API workspaces"}}
{"id":"dev-api-edit-request-without-send","kind":"control","prompt":"Change only the Health endpoint URL in saved API workspace api-fixture, request requests.json/c0/r0, to <<API_ORIGIN>>/v2/health. Inspect its current native request and revision, preserve every other field, and save the edit through Loom. Do not send any HTTP request or edit any original import file.","setup":{"role":"top","mocks":{"loom_dev_api_request":{"workspace":{"id":"api-fixture","name":"Acme","requestCount":1,"environmentCount":1},"revision":"request-r3","requests":[{"id":"requests.json/c0/r0","name":"Health","folders":["Acme"],"method":"GET"}],"environments":[],"dotenvFiles":[],"selected":{"id":"requests.json/c0/r0","sourceJson":"{\"v\": \"17\", \"name\": \"Health\", \"method\": \"GET\", \"endpoint\": \"<<API_ORIGIN>>/health\", \"headers\": [], \"params\": [], \"extension\": {\"preserve\": true}}","endpoint":"<<API_ORIGIN>>/health","bodyContentType":null,"preScripts":[],"testScripts":[]}}}},"expect":{"calls":[{"tool":"loom_dev_api_request","args":{"action":"read","workspaceId":"api-fixture","requestKey":"requests.json/c0/r0"}},{"tool":"loom_dev_api_request","args":{"action":"save","workspaceId":"api-fixture","expectedRevision":"request-r3"}}],"notCalls":["loom_dev_api_send","loom_dev_request"]},"maxSteps":9,"area":"browser-dev-tools","pattern":"saved native request edits preserve source without sending","experience":"The HTTP lab must let people edit saved endpoints while preserving imported native fields.","source":{"feature":"L11 saved request editor"}}
{"id":"dev-api-multipart-upload","kind":"control","prompt":"Send the Upload endpoint once in API workspace api-fixture with No environment. Field 0 is text, field 1 is an active file field. For field 1 explicitly use the public synthetic notes.txt file, text/plain, whose exact base64 bytes are Zml4dHVyZQ==. Read latest revisions first; use Loom API tools, not curl. Report status and checks.","setup":{"role":"top","mocks":{"loom_dev_api_workspace":{"workspaces":[],"workspace":{"workspace":{"id":"api-fixture","name":"Acme","requestCount":1,"environmentCount":1},"revision":"workspace-r1","requests":[{"id":"requests.json/c0/r0","name":"Upload","folders":["Acme"],"method":"POST"}],"environments":[{"id":"local.json/e0","name":"Local"}],"dotenvFiles":[".env.local"],"selected":{"id":"requests.json/c0/r0","name":"Upload","sourceJson":"{\"v\": \"17\", \"name\": \"Upload\", \"method\": \"POST\", \"endpoint\": \"http://localhost:3000/upload\", \"body\": {\"contentType\": \"multipart/form-data\", \"body\": [{\"key\": \"title\", \"value\": \"report\", \"active\": true, \"isFile\": false}, {\"key\": \"file\", \"value\": [], \"active\": true, \"isFile\": true}]}}"}}},"loom_dev_api_environment":{"revision":"environment-r2","variables":[{"key":"API_ORIGIN","secret":false,"isSet":true}]},"loom_dev_api_send":{"exchange":{"id":"health-run","request":{"method":"GET","url":"http://localhost:3000/health","headers":{},"body":"","timeoutMs":30000},"startedAt":"2026-11-02T12:00:00Z","durationMs":3,"status":200,"headers":{},"body":"{\"ok\":true}","byteLength":11,"truncated":false,"binary":false,"error":null},"checks":[{"name":"health is ok","passed":true}],"environmentUpdated":true}}},"expect":{"calls":[{"tool":"loom_dev_api_workspace","args":{"action":"read","workspaceId":"api-fixture"}},{"tool":"loom_dev_api_environment","args":{"action":"read","source.kind":"none"}},{"tool":"loom_dev_api_send","args":{"workspaceId":"api-fixture","requestKey":"requests.json/c0/r0","expectedRevision":"workspace-r1","environmentRevision":"environment-r2","source.kind":"none","uploads.0.fieldIndex":1,"uploads.0.fileName":"notes.txt","uploads.0.contentType":"text/plain","uploads.0.base64":"Zml4dHVyZQ=="}}],"maxCalls":{"loom_dev_api_send":1},"notCalls":["loom_dev_request"],"order":["loom_dev_api_workspace","loom_dev_api_environment","loom_dev_api_send"],"shellMustNot":["curl|wget"]},"maxSteps":9,"area":"browser-dev-tools","pattern":"multipart sends use explicit file bytes and guarded request receipts","experience":"Imported multipart forms previously failed before dispatch; file selection must stay explicit and the agent must use the supported service.","source":{"feature":"L11 API workspaces"}}
