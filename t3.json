{
  "$schema": "https://t3.codes/schema/t3.json",
  "iconPath": "assets/dev/blueprint-web-apple-touch-180.png",
  "scripts": [
    {
      "name": "Setup Worktree",
      "command": "node scripts/setup-worktree.ts",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Development with sample data",
      "command": "vp run dev:fixtures",
      "icon": "play"
    },
    {
      "name": "Reset development data",
      "command": "node apps/server/scripts/seed-dev-db.ts --reset",
      "icon": "configure"
    }
  ]
}
